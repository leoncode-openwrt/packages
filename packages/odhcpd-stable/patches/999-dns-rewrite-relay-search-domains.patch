 #include "statefiles.h"
 
@@ -1266,6 +1267,9 @@ static void forward_router_advertisement(const struct interface *iface, uint8_t
 	}
 
 	avl_for_each_element(&interfaces, c, avl) {
+		uint8_t *rewritten_ra = NULL;
